#version 460 core
// Builds the lens table of gas_lens.glsl for a camera at radius uCamR: one invocation per ray of the fan.
layout(local_size_x = 64) in;
#include "geodesic.glsl"
#include "gas_lens.glsl"

layout(r32f, binding = 0) uniform writeonly image2D uTable;   // x: ray, y: swept angle
uniform float uCamR;
uniform float uAlphaCrit;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= LENS_RAYS) return;
    float a = lensAlpha((float(i) + 0.5) / float(LENS_RAYS), uAlphaCrit);
    // The camera on +X, the ray turning towards +Y: the same start as a tracer ray (static observer).
    vec3 x = vec3(uCamR, 0.0, 0.0);
    vec3 v = initialVelocity(x, vec3(-cos(a), sin(a), 0.0));
    vec3 hv = cross(x, v);
    float h2 = dot(hv, hv);
    const float dPhi = TWO_PI / float(LENS_PHIS - 1);
    const float logH = log(R_HORIZON);
    imageStore(uTable, ivec2(i, 0), vec4(log(uCamR)));
    int j = 1;
    float phi = 0.0, r = uCamR;
    for (int s = 0; s < 20000 && j < LENS_PHIS; ++s) {
        // Steps proportional to r, finer near the photon sphere where rays wind round the hole.
        float ds = (r < 8.0 ? 0.004 : 0.01) * r;
        vec3 x0 = x;
        float r0 = r;
        rk4Step(x, v, h2, ds / length(v));
        r = length(x);
        float dphi = atan(x0.x * x.y - x0.y * x.x, dot(x0.xy, x.xy));
        float phi1 = phi + dphi;
        for (; j < LENS_PHIS && float(j) * dPhi <= phi1; ++j) {
            float t = clamp((float(j) * dPhi - phi) / max(dphi, 1e-12), 0.0, 1.0);
            imageStore(uTable, ivec2(i, j), vec4(max(log(mix(r0, r, t)), logH)));
        }
        phi = phi1;
        if (r < R_HORIZON + 0.01 || (r > LENS_RMAX && dot(x, v) > 0.0)) break;
    }
    // Angles the ray never reaches: it fell in, or escaped, first.
    float fill = r < 10.0 ? logH : log(LENS_RMAX);
    for (; j < LENS_PHIS; ++j) imageStore(uTable, ivec2(i, j), vec4(fill));
}
